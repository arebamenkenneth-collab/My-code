.tp.done span { opacity: 0.5; text-decoration: line-through; }

.tp span { overflow-wrap: anywhere; }

details.sub .addrow { padding-top: 10px; border-top: 1px solid var(--line); }

details.sub .rmg { padding-top: 4px; }

.newgroup { margin-top: 6px; }

.boost { background: var(--blue); color: rgb(255, 255, 255); border-radius: 28px; padding: 26px 22px; min-height: 190px; display: flex; flex-direction: column; justify-content: space-between; gap: 20px; }

.boost blockquote { font: 700 27px / 1.2 "Bricolage Grotesque", Figtree, system-ui, sans-serif; letter-spacing: -0.02em; }

.boost blockquote.swap { animation: 0.45s ease 0s 1 normal none running swap; }

@keyframes swap { 
  0% { opacity: 0; transform: translateY(14px); }
  100% { opacity: 1; transform: none; }
}

.btn { border: 0px; border-radius: 14px; padding: 13px 18px; font-weight: 600; font-size: 16px; background: var(--sun); color: var(--ink); }

.btn.dark { background: var(--ink); color: rgb(255, 255, 255); }

.btn.small { padding: 10px 14px; font-size: 14.5px; background: var(--blue); color: rgb(255, 255, 255); flex: 0 0 auto; }

.row { display: flex; gap: 10px; margin-top: 12px; }

.row .btn { flex: 1 1 0%; }

.rules { margin-top: 22px; }

.rules h2, .why h2 { font-size: 21px; font-weight: 800; margin: 0px 4px 10px; }

.rules ol { list-style: none; display: grid; gap: 10px; }

.rules li { background: rgb(255, 255, 255); border-radius: 16px; padding: 14px 16px; font-size: 15px; }

.rules li b { display: block; font-size: 16.5px; margin-bottom: 2px; }

.setrow { background: rgb(255, 255, 255); border-radius: 16px; padding: 14px 16px; margin-bottom: 10px; display: flex; align-items: center; gap: 12px; }

.setrow div { flex: 1 1 0%; min-width: 0px; }

.setrow b { display: block; font-size: 16px; }

.setrow span.st { display: block; font-size: 13.5px; color: var(--muted); }

.switch { position: relative; width: 52px; height: 30px; flex: 0 0 auto; }

.switch input { position: absolute; inset: 0px; opacity: 0; width: 100%; height: 100%; margin: 0px; cursor: pointer; }

.switch i { position: absolute; inset: 0px; border-radius: 99px; background: rgb(199, 208, 234); transition: background 0.2s; pointer-events: none; }

.switch i::after { content: ""; position: absolute; left: 3px; top: 3px; width: 24px; height: 24px; border-radius: 50%; background: rgb(255, 255, 255); transition: transform 0.2s; }

.switch input:checked + i { background: var(--mint); }

.switch input:checked + i::after { transform: translateX(22px); }

.switch input:focus-visible + i { outline: 3px solid var(--sun); outline-offset: 2px; }

.why { margin-top: 22px; }

.why textarea { width: 100%; min-height: 92px; border: 2px solid var(--line); border-radius: 16px; padding: 12px 14px; font: 500 15.5px Figtree, system-ui, sans-serif; color: var(--ink); background: rgb(255, 255, 255); resize: vertical; }

.why textarea:focus { border-color: var(--blue); outline: none; }

.sign { text-align: center; font-size: 13.5px; color: var(--muted); margin-top: 26px; }

nav { position: fixed; bottom: 0px; left: 50%; transform: translateX(-50%); width: min(100%, 480px); background: rgb(255, 255, 255); border-top: 1px solid var(--line); display: grid; grid-template-columns: repeat(5, 1fr); padding: 8px 6px calc(8px + env(safe-area-inset-bottom)); z-index: 10; }

nav button { background: none; border: 0px; display: flex; flex-direction: column; align-items: center; gap: 3px; font-size: 12px; font-weight: 600; color: var(--muted); padding: 6px 2px; border-radius: 12px; transition: color 0.2s; }

nav button[aria-current="true"] { color: var(--blue); }

nav svg { width: 23px; height: 23px; fill: none; stroke: currentcolor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

#toast { position: fixed; left: 50%; bottom: 92px; transform: translate(-50%, 20px); background: var(--ink); color: rgb(255, 255, 255); padding: 11px 18px; border-radius: 14px; font-size: 14.5px; font-weight: 600; opacity: 0; pointer-events: none; transition: 0.3s; z-index: 20; max-width: 90%; text-align: center; }

#toast.show { opacity: 1; transform: translate(-50%, 0px); }

@media (prefers-reduced-motion: reduce) {
  * { animation: auto ease 0s 1 normal none running none !important; transition: none !important; }
  .arc { stroke-dashoffset: 0 !important; }
}
